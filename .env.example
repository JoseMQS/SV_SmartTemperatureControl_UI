# Copia este ficheiro para ".env" e preenche os valores.
# O ".env" NUNCA deve ir para o GitHub (já está no .gitignore).

# ---- Broker MQTT (EMQX Cloud) ----
# Host e porta tirados diretamente do teu flow do Node-RED.
BROKER_HOST=xf7518f8.ala.eu-central-1.emqxsl.com
BROKER_PORT=8883
BROKER_USE_TLS=true
# Utilizador/password que já usavas no nó "emqx_brokie" do Node-RED
# (não vêm no export do flow por segurança — vai buscá-los ao painel do EMQX Cloud).
BROKER_USER=
BROKER_PASS=
# Caminho para o certificado da CA da EMQX Cloud (emqxsl-ca.crt).
# Deixa em branco para tentar usar a validação TLS por omissão do Node.
# Ver instruções mais abaixo / no README sobre como obter este ficheiro.
BROKER_CA_PATH=./certs/emqxsl-ca.crt

# ---- Tópicos e devices ----
TOPIC_BASE=QSAAFrigus
# O teu flow já tem os 5 sensores montados (Device1..Device5) — inclui o sensor5 aqui.
DEVICE_IDS=sensor1,sensor2,sensor3,sensor4,sensor5
# 60000 ms = 1 minuto, igual ao threshold usado no flow para marcar um device como offline.
OFFLINE_MS=60000
# Limite de temperatura para alerta, igual ao valor fixo (20) usado na FunctionMarada do flow.
TEMP_ALERT_THRESHOLD=20

# ---- Email de alerta (SMTP) ----
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
# Conta de email usada no nó "e-mail" do flow — confirma se é esta.
SMTP_USER=qsaacyprestes@gmail.com
# App Password da conta Gmail (Definições da Google Account -> Segurança -> Palavras-passe de app).
# NÃO é a password normal da conta.
SMTP_PASS=
ALERT_EMAIL_FROM=qsaacyprestes@gmail.com
# No flow o destinatário principal está escondido (guardado como credencial, não aparece no export)
# e o teu email pessoal só entra em CC. Podes pôr os dois aqui separados por vírgula.
ALERT_EMAIL_TO=josemrqs99@gmail.com

# ---- InfluxDB Cloud ----
INFLUX_URL=https://eu-central-1-1.aws.cloud2.influxdata.com
# Token não vem no export do flow — vai buscá-lo ao painel da InfluxDB Cloud.
INFLUX_TOKEN=
# No flow aparece literalmente "organisation" — confirma se é o nome real da tua org no InfluxDB Cloud
# ou se é só um valor de exemplo que ficou por preencher.
INFLUX_ORG=organisation
INFLUX_BUCKET=QSAAFrigus
# Intervalo mínimo entre gravações de temperatura por sensor, em milissegundos.
# Evita gravar uma leitura a cada mensagem MQTT (podem chegar a cada poucos segundos).
INFLUX_WRITE_INTERVAL_MS=30000

# ---- API do backend (para o dashboard falar com este serviço) ----
HTTP_PORT=3000
# Chave principal (acesso total, aparece nos logs como "admin"). Inventa uma password longa e aleatória.
API_KEY=
# Chaves extra, uma por pessoa, para saberes nos logs quem enviou cada comando.
# Formato: Nome:chave,Nome2:chave2 (cada pessoa usa a sua própria chave no dashboard)
API_KEYS=
